# Force LF line endings for shell scripts (required for Linux/Railway)
*.sh text eol=lf

# Force LF for Python files
*.py text eol=lf

# Force LF for YAML/JSON/Markdown
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
