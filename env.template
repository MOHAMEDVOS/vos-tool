# ============================================
# VOS Tool - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vos_tool
POSTGRES_USER=vos_user
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# Security Keys
# ============================================
# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# ============================================
# AssemblyAI Configuration (Required)
# ============================================
# Get your API key from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# AssemblyAI Transcription Settings
# Timeout for transcription API calls (in seconds)
# Default: 300 (5 minutes)
# For 30-60s files, system uses progressive timeout (180-210s)
ASSEMBLYAI_TRANSCRIPTION_TIMEOUT=300

# AssemblyAI Polling Interval (seconds between status checks)
ASSEMBLYAI_POLLING_INTERVAL=5

# AssemblyAI Retry Attempts (number of retries on failure)
ASSEMBLYAI_RETRY_ATTEMPTS=3

# Enable Speaker Diarization (true/false)
# Disabled by default for faster processing
ASSEMBLYAI_ENABLE_SPEAKER_DIARIZATION=false

# ============================================
# Rebuttal Detection Timeouts
# ============================================
# Base timeout for rebuttal detection (in seconds)
# Default: 180 (3 minutes) - calculated dynamically based on file duration
# For 30-60s files: timeout will be 180-210s (3-3.5 minutes)
# Formula: BASE + (file_duration_minutes × 30s), capped at 60s-600s
ASSEMBLYAI_REBUTTAL_TIMEOUT_SECONDS=180

# Maximum audio duration for rebuttal detection (in seconds)
# Files longer than this will skip rebuttal detection
# Default: 600 (10 minutes)
MAX_REBUTTAL_DURATION_SECONDS=600

# ============================================
# Processing Timeouts
# ============================================
# Single file processing timeout (in seconds)
# Default: 600 (10 minutes)
PROCESSING_TIMEOUT_SINGLE_FILE=600

# Lite audit processing timeout (in seconds)
# Default: 60 (1 minute)
PROCESSING_TIMEOUT_LITE_FILE=60

# ============================================
# Server Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
DEBUG=false

# CORS Origins (comma-separated list)
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=

# ============================================
# ReadyMode Configuration (Optional)
# ============================================
# Enable ReadyMode automation
FORCE_READYMODE=false
READYMODE_USER=your_readymode_username
READYMODE_PASSWORD=your_readymode_password

# ============================================
# File Storage
# ============================================
# Recordings directory path
# Default: ./Recordings (project root)
RECORDINGS_ROOT=

# Upload directory path
# Default: Uses RECORDINGS_ROOT or ./Recordings
UPLOAD_DIR=

# ============================================
# HuggingFace Model Configuration (Railway/Cloud)
# ============================================
# HuggingFace cache directory for model storage
# Railway: Use /app/.cache/huggingface for persistence
# Local: Uses default ~/.cache/huggingface
HF_HOME=/app/.cache/huggingface
TRANSFORMERS_CACHE=/app/.cache/huggingface/transformers
HF_HUB_CACHE=/app/.cache/huggingface/hub

# HuggingFace Hub settings
# Set to 1 to enable offline mode (use cached models only)
HF_HUB_OFFLINE=0

# Set to 1 to disable telemetry
HF_HUB_DISABLE_TELEMETRY=1

# ============================================
# Advanced Settings (Optional)
# ============================================
# Encryption key for sensitive data
ENCRYPTION_KEY=

# Session secret for session management
SESSION_SECRET=

# Deployment mode (auto/enterprise/production)
DEPLOYMENT_MODE=auto

# Database connection pool settings
DB_POOL_MAX_SIZE=50
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=30000

# Concurrency settings
MAX_CONCURRENT_USERS=4

# ============================================
# Notes
# ============================================
# - Timeout values are in seconds
# - Rebuttal detection timeout is calculated dynamically:
#   * 30s file → ~180s timeout (3 min)
#   * 60s file → ~210s timeout (3.5 min)
#   * Longer files scale proportionally up to 600s max
# - If you experience timeouts, you can increase:
#   * ASSEMBLYAI_REBUTTAL_TIMEOUT_SECONDS (for rebuttal detection)
#   * ASSEMBLYAI_TRANSCRIPTION_TIMEOUT (for transcription)
#   * PROCESSING_TIMEOUT_SINGLE_FILE (for overall file processing)
