# Environment Variables Template for VOS Tool
# Local dev: copy this file to .env and fill in your values.
# Railway: this file is for reference only — Railway uses the Variables tab in the
# dashboard, do not commit actual secrets to this file.

# ============================================
# Database Connection
# ============================================
DB_TYPE=postgresql
# Railway recommended: use DATABASE_URL (or the PG* variables Railway injects)
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vos_tool
POSTGRES_USER=vos_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SSLMODE=require

# Database Pool Settings
# Each user uses 4-8 connections on average. Production is currently running at
# 200 (see CLAUDE.md known gotchas — this is flagged as needing a reduction to
# ~30-50 once pool usage is retuned; don't lower it without checking that first).
DB_POOL_MAX_SIZE=200
DB_POOL_MIN_SIZE=20
DB_CONNECT_TIMEOUT=30
DB_QUERY_TIMEOUT=30000

# ============================================
# Security Keys (generate new ones for production!)
# ============================================
# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
# Encryption key for sensitive data (per-user API keys, etc.)
ENCRYPTION_KEY=
SESSION_SECRET=

# ============================================
# Application Settings
# ============================================
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DEPLOYMENT_MODE=auto
MAX_CONCURRENT_USERS=4
MAX_CONCURRENT_JOBS_PER_USER=3

# ============================================
# AssemblyAI Configuration (required for transcription)
# ============================================
# Get your API key from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Timeout for transcription API calls (seconds). Default 300 (5 min); system uses
# a progressive timeout for short files (180-210s for 30-60s recordings).
ASSEMBLYAI_TRANSCRIPTION_TIMEOUT=300
ASSEMBLYAI_POLLING_INTERVAL=5
ASSEMBLYAI_RETRY_ATTEMPTS=3
# Disabled by default for faster processing
ASSEMBLYAI_ENABLE_SPEAKER_DIARIZATION=false

# Rebuttal detection timeout (seconds). Calculated dynamically from file
# duration: BASE + (minutes * 30s), capped at 60-600s.
ASSEMBLYAI_REBUTTAL_TIMEOUT_SECONDS=180
# Files longer than this skip rebuttal detection entirely (seconds)
MAX_REBUTTAL_DURATION_SECONDS=600

# Single-file / lite-audit processing timeouts (seconds)
PROCESSING_TIMEOUT_SINGLE_FILE=600
PROCESSING_TIMEOUT_LITE_FILE=60

# ============================================
# Groq / LLM Rebuttal-Evaluation Fallback (optional)
# ============================================
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# llama-3.1-8b-instant = fastest/cheapest, llama-3.1-70b-versatile = best quality
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=300
GROQ_TIMEOUT=10

# Only triggers when semantic-match confidence is below this threshold (0.0-1.0)
LLM_FALLBACK_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.70

# ============================================
# ReadyMode Configuration (optional)
# ============================================
FORCE_READYMODE=false
READYMODE_USER=your_readymode_username
READYMODE_PASSWORD=your_readymode_password

# ============================================
# TL Actions (optional overrides — defaults point at the production sheets)
# ============================================
TL_ACTIONS_SPREADSHEET_ID=1x_pcfm0_NMpfAYLIOHStTKwgA94k9chcrZbJyx1gJII
TL_ACTIONS_WAIVER_SPREADSHEET_ID=1zlyYv5srp_mjEFlADeMOPLbF7u3shWjtzXSwqbuCwYI
TL_ACTIONS_WAIVER_SHEET_NAME=Audit Reply

# ============================================
# File Storage
# ============================================
# Default: ./Recordings (project root) if left blank
RECORDINGS_ROOT=
# Default: uses RECORDINGS_ROOT if left blank
UPLOAD_DIR=

# ============================================
# HuggingFace Model Configuration (Railway/Cloud)
# ============================================
# Railway: use /app/.cache/huggingface for persistence across deploys.
# Local: leave unset to use the default ~/.cache/huggingface.
HF_HOME=/app/.cache/huggingface
TRANSFORMERS_CACHE=/app/.cache/huggingface/transformers
HF_HUB_CACHE=/app/.cache/huggingface/hub
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_TELEMETRY=1

# ============================================
# Redis / Timezone
# ============================================
REDIS_URL=redis://redis:6379
TZ=America/New_York

# ============================================
# Notes
# ============================================
# - Rebuttal detection timeout scales with file length:
#     30s file  -> ~180s timeout (3 min)
#     60s file  -> ~210s timeout (3.5 min)
#     longer files scale proportionally, capped at 600s
# - If you see timeouts, raise ASSEMBLYAI_REBUTTAL_TIMEOUT_SECONDS,
#   ASSEMBLYAI_TRANSCRIPTION_TIMEOUT, or PROCESSING_TIMEOUT_SINGLE_FILE.
