{
  "manifest_version": 3,
  "name": "VOS ReadyMode Browser Connector",
  "version": "1.1.0",
  "description": "Uses the user's signed-in Chrome sessions to import ReadyMode calls into VOS.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "https://resva.readymode.com/*",
    "https://resva2.readymode.com/*",
    "https://resva3.readymode.com/*",
    "https://resva4.readymode.com/*",
    "https://resva5.readymode.com/*",
    "https://resva6.readymode.com/*",
    "https://resva7.readymode.com/*",
    "https://vos-tool.up.railway.app/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vos-tool.up.railway.app/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["vos-content.js"],
      "run_at": "document_start"
    }
  ]
}
