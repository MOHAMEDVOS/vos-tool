# Example .env Configuration for LLM Rebuttal Evaluation

# ==========================================
# GroqCloud API Configuration
# ==========================================

# Your GroqCloud API key (get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_...kWR2

# Model selection (recommended for free tier: llama-3.1-8b-instant)
# Options:
#   - llama-3.1-8b-instant  (fastest, lowest tokens, free tier friendly)
#   - llama-3.1-70b-versatile (best quality, slower, higher token usage)
#   - mixtral-8x7b-32768 (balanced)
GROQ_MODEL=qwen/qwen3.8-27b

# LLM temperature (0.0 = deterministic, 1.0 = creative)
# Lower temperature = more consistent evaluations
GROQ_TEMPERATURE=0.2

# Maximum tokens in LLM response
GROQ_MAX_TOKENS=300

# API request timeout (seconds)
GROQ_TIMEOUT=10

# ==========================================
# LLM Fallback Configuration
# ==========================================

# Enable/disable LLM fallback (true/false)
LLM_FALLBACK_ENABLED=true

# Confidence threshold to trigger LLM fallback
# LLM only triggers when semantic matching confidence < this value
# Range: 0.0-1.0 (recommended: 0.70)
LLM_CONFIDENCE_THRESHOLD=0.70

# ==========================================
# Existing Configuration (AssemblyAI, etc.)
# ==========================================

ASSEMBLYAI_API_KEY=your_assemblyai_key_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vos_tool
POSTGRES_USER=vos_user
POSTGRES_PASSWORD=your_password_here

# ... rest of your existing configuration
